@model IEnumerable<Moment3.Models.Borrow>

@{
    ViewData["Title"] = "Utlånade böcker";
}

<h1>Utlånade böcker</h1>

<p>
    <a asp-action="Create" class="create-link">Låna ut bok</a>
</p>
<table class="db-showcase">
    <thead>
        <tr>
            <th>
                @Html.DisplayNameFor(model => model.Person)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Book)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Date)
            </th>
            <th></th>
        </tr>
    </thead>
    <tbody>
@foreach (var item in Model) {
        <tr>
            <td>
                @Html.DisplayFor(modelItem => item.Person.Name)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.Book.Title)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.Date)
            </td>
            <td class="borrow-delete-nav">
                <nav>
                    <a asp-action="Delete" asp-route-id="@item.Id">Ta bort lån</a>
                </nav>
            </td>
        </tr>
}
    </tbody>
</table>
