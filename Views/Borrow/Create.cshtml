@model Moment3.Models.Borrow

@{
    ViewData["Title"] = "Låna ut bok";
}

<h1>Låna ut bok</h1>
<div>
    <div>
        <form asp-action="Create" class="create-edit-form">
            <div asp-validation-summary="ModelOnly"></div>
            <div>
                <label asp-for="PersonId"></label>
                <select asp-for="PersonId" asp-items="ViewBag.PersonId"></select>
            </div>
            <div>
                <label asp-for="BookId"></label>
                <select asp-for="BookId" asp-items="ViewBag.BookId"></select>
            </div>
            <div>
                <input type="submit" value="Låna ut bok" />
            </div>
        </form>
    </div>
</div>

<div>
    <a asp-action="Index" class="return-link">Tillbaks till lån</a>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}
