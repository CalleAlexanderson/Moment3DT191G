@model Moment3.Models.Borrow

@{
    ViewData["Title"] = "Ta bort lån";
}

<h1>Ta bort lån</h1>

<div>
    <dl class="display-cointainer">
        <div>
            <dt>
                @Html.DisplayNameFor(model => model.Person)
            </dt>
            <dd>
                @Html.DisplayFor(model => model.Person.Name)
            </dd>
        </div>
        <div>
            <dt>
                @Html.DisplayNameFor(model => model.Book)
            </dt>
            <dd>
                @Html.DisplayFor(model => model.Book.Title)
            </dd>
        </div>
        <div>
            <dt>
                @Html.DisplayNameFor(model => model.Date)
            </dt>
            <dd>
                @Html.DisplayFor(model => model.Date)
            </dd>
        </div>
    </dl>

    <form asp-action="Delete">
        <input type="hidden" asp-for="Id" />
        <input type="submit" value="Ta bort" class="delete-btn" />
        <a asp-action="Index" class="return-link">Tillbaks till lån</a>
    </form>
</div>
