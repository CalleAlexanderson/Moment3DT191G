@model Moment3.Models.Person

@{
    ViewData["Title"] = "Radera";
}

<h1>Radera</h1>

<div>
    <dl class="display-cointainer">
        <div>
            <dt>
                @Html.DisplayNameFor(model => model.Name)
            </dt>
            <dd>
                @Html.DisplayFor(model => model.Name)
            </dd>
        </div>
        <div>
            <dt>
                @Html.DisplayNameFor(model => model.Email)
            </dt>
            <dd class="person-mail">
                @Html.DisplayFor(model => model.Email)
            </dd>
        </div>
    </dl>
    <form asp-action="Delete">
        <input type="hidden" asp-for="Id" />
        <input type="submit" value="Ta bort" class="delete-btn" />
        <a asp-action="Index" class="return-link">Tillbaks till användare</a>
    </form>
</div>
