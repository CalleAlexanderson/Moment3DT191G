@model Moment3.Models.Author

@{
    ViewData["Title"] = "Lägg till författare";
}

<h1>Lägg till författare</h1>

<hr />
<div>
    <div>
        <form asp-action="Create" class="create-edit-form">
            <div asp-validation-summary="ModelOnly"></div>
            <div>
                <label asp-for="Name"></label>
                <input asp-for="Name"/>
                <span asp-validation-for="Name"></span>
            </div>

            <div>
                <label asp-for="Gender"></label>
                <input asp-for="Gender"/>
                <span asp-validation-for="Gender"></span>
            </div>
            <div>
                <input type="submit" value="Lägg till" />
            </div>
        </form>
    </div>
</div>

<div>
    <a asp-action="Index" class="return-link">Tillbaks till författare</a>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
