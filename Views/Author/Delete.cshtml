@model Moment3.Models.Author

@{
    ViewData["Title"] = "Radera";
}

<h1>Radera</h1>

<h3>Är du säker på att du vill ta bort författaren?</h3>
<div>
    <hr />
    <dl  class="display-cointainer">
        <dt>
            @Html.DisplayNameFor(model => model.Name)
        </dt>
        <dd>
            @Html.DisplayFor(model => model.Name)
        </dd>
    </dl>
    
    <form asp-action="Delete">
        <input type="hidden" asp-for="Id" />
        <input type="submit" value="Ta bort" class="delete-btn" /> 
        <a asp-action="Index" class="return-link">Tillbaks till författare</a>
    </form>
</div>
