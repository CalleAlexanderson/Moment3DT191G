@model IEnumerable<Moment3.Models.Author>

@{
    ViewData["Title"] = "Författare";
}

<h1>Författare</h1>

<p>
    <a asp-action="Create" class="create-link">Lägg till författare</a>
</p>
<table class="db-showcase">
    <thead>
        <tr>
            <th>
                @Html.DisplayNameFor(model => model.Name)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Gender)
            </th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td>
                    @Html.DisplayFor(modelItem => item.Name)
                </td>
                <td>
                    @Html.DisplayFor(modelItem => item.Gender)
                </td>
                <td class="table-nav-td">
                    <nav class="table-nav">
                        <a asp-action="Edit" asp-route-id="@item.Id">Ändra</a>
                        <a asp-action="Details" asp-route-id="@item.Id">Info</a>
                        <a asp-action="Delete" asp-route-id="@item.Id">Radera</a>
                    </nav>
                </td>
            </tr>
        }
    </tbody>
</table>
