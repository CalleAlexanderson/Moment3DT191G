@model IEnumerable<Moment3.Models.Book>

@{
    ViewData["Title"] = "Böcker";
}

<h1>Böcker</h1>

<nav>
    <a asp-area="" asp-controller="Borrow" asp-action="Index" class="create-link">Utlånade böcker</a>
</nav>

<p>
    <a asp-action="Create" class="create-link">Lägg till bok</a>
</p>

<form asp-action="Search" class="search-form">
    <label for="searchtitle">Sök bok:</label>
    <input type="text" name="searchtitle" id="searchtitle">
    <input type="submit" value="Sök" />
</form>

<table class="db-showcase">
    <thead>
        <tr>
            <th>
                @Html.DisplayNameFor(model => model.Title)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Series)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Author)
            </th>
            <th></th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td>
                    @Html.DisplayFor(modelItem => item.Title)
                </td>
                <td>
                    @Html.DisplayFor(modelItem => item.Series)
                </td>
                <td>
                    @* ändrade så författarens namn visas *@
                    @Html.DisplayFor(modelItem => item.Author.Name)
                </td>
                <td class="table-nav-td">
                    <nav class="table-nav">
                        <a asp-action="Edit" asp-route-id="@item.Id">Ändra</a>
                        <a asp-action="Details" asp-route-id="@item.Id">Info</a>
                        <a asp-action="Delete" asp-route-id="@item.Id">Radera</a>
                    </nav>
                </td>
            </tr>
        }
    </tbody>
</table>
