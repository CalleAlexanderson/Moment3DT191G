@model Moment3.Models.Book

@{
    ViewData["Title"] = "Radera";
}

<h1>Radera</h1>
<div>
    <hr />
    <dl class="display-cointainer">
        <div>
            <dt>
                @Html.DisplayNameFor(model => model.Title)
            </dt>
            <dd>
                @Html.DisplayFor(model => model.Title)
            </dd>
        </div>
        <div>
            <dt>
                @Html.DisplayNameFor(model => model.Series)
            </dt>
            <dd>
                @Html.DisplayFor(model => model.Series)
            </dd>
        </div>
        <div>
            <dt>
                @Html.DisplayNameFor(model => model.ISBN)
            </dt>
            <dd>
                @Html.DisplayFor(model => model.ISBN)
            </dd>
        </div>
        <div>
            <dt>
                @Html.DisplayNameFor(model => model.Author)
            </dt>
            <dd>
                @Html.DisplayFor(model => model.Author.Name)
            </dd>
        </div>
    </dl>

    <form asp-action="Delete">
        <input type="hidden" asp-for="Id" />
        <input type="submit" value="Ta bort" class="delete-btn" />
        <a asp-action="Index" class="return-link">Tillbaks till böcker</a>
    </form>
</div>
