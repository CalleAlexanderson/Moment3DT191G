@model Moment3.Models.Book

@{
    ViewData["Title"] = "Ändra";
}

<h1>Ändra</h1>

<hr />
<div>
    <div>
        <form asp-action="Edit" class="create-edit-form">
            <div asp-validation-summary="ModelOnly" class="form-warning"></div>
            <input type="hidden" asp-for="Id" />
            <div>
                <label asp-for="Title"></label>
                <input asp-for="Title" />
                <span asp-validation-for="Title" class="form-warning"></span>
            </div>
            <div>
                <label asp-for="Series"></label>
                <input asp-for="Series" />
                <span asp-validation-for="Series" class="form-warning"></span>
            </div>
            <div>
                <label asp-for="ISBN"></label>
                <input asp-for="ISBN" />
                <span asp-validation-for="ISBN" class="form-warning"></span>
            </div>
            <div>
                <label asp-for="AuthorId"></label>
                <select asp-for="AuthorId" asp-items="ViewBag.AuthorId"></select>
                <span asp-validation-for="AuthorId" class="form-warning"></span>
            </div>
            <div>
                <input type="submit" value="Spara" />
            </div>
        </form>
    </div>
</div>

<div>
    <a asp-action="Index">Tillbaks till böcker</a>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}
