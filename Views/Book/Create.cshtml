@model Moment3.Models.Book

@{
    ViewData["Title"] = "Lägg till bok";
}

<h1>Lägg till bok</h1>

<hr />
<div>
    <div>
        <form asp-action="Create" class="create-edit-form">
            <div asp-validation-summary="ModelOnly"></div>
            <div>
                <label asp-for="Title"></label>
                <input asp-for="Title"/>
                <span asp-validation-for="Title" class="form-warning"></span>
            </div>
            <div>
                <label asp-for="Series"></label>
                <input asp-for="Series" />
                <span asp-validation-for="Series" class="form-warning"></span>
            </div>
            <div>
                <label asp-for="ISBN"></label>
                <input asp-for="ISBN"/>
                <span asp-validation-for="ISBN" class="form-warning"></span>
            </div>
            <div>
                <label asp-for="AuthorId"></label>
                <select asp-for="AuthorId" asp-items="ViewBag.AuthorId"></select>
            </div>
            <div>
                <input type="submit" value="Lägg till"/>
            </div>
        </form>
    </div>
</div>

<div>
    <a asp-action="Index">Tillbaks till böcker</a>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
