@model Moment3.Models.Book

@{
    ViewData["Title"] = "Info";
}

<h1>Info</h1>

<div>
    <hr />
    <dl class="display-cointainer">
        <div>
            <dt>
                @Html.DisplayNameFor(model => model.Title)
            </dt>
            <dd>
                @Html.DisplayFor(model => model.Title)
